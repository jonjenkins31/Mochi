[Header start]
! ----------------------------------------------------
! SCRIPT: gfx_demo
! DESC: A demonstration of various graphics functions.
! AUTHOR: Conversion Tool
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
LBL[1:Start]
    MATH NAME[test_fill_screen] COLORS[BLACK,RED,GREEN,BLUE] DURATION[0.5] D[2.5]
    MATH NAME[test_text] TEXT['Mochi GFX'] COLOR[YELLOW] SIZE[3] X[2] Y[10] D[3.0]
    MATH NAME[test_text] TEXT['Powered by NumPy'] COLOR[CYAN] SIZE[1] X[4] Y[40] D[2.5]
    MATH NAME[test_filled_rects] COLOR1[YELLOW] COLOR2[MAGENTA] D[5.0]
    MATH NAME[test_filled_circles] COLOR[MAGENTA] RADIUS[12] D[3.0]
    MATH NAME[test_filled_triangles] D[5.0]
    MATH NAME[test_filled_round_rects] COLOR[GREEN] D[5.0]
    MATH NAME[test_fast_lines] COLOR1[50,0,0] COLOR2[0,0,50] CLEAR[true] D[0.1]
    MATH NAME[test_rects] COLOR[GREEN] CLEAR[false] D[4.0]
    MATH NAME[test_circles] COLOR[WHITE] RADIUS[15] CLEAR[false] D[4.0]
    MATH NAME[test_triangles] COLOR[RED] CLEAR[false] D[5.0]
LBL[9999:End]
[Main end]

