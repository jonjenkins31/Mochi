[Header start]
! ----------------------------------------------------
! SCRIPT: random_emotes
! DESC: Displays random emotes using a config file.
! AUTHOR: Conversion Tool
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
LBL[1:Start]
    MATH NAME[sprite] CONFIG_PATH['random_emotes_config.mscript'] D[0.0]
LBL[9999:End]
[Main end]

