[Header start]
! ----------------------------------------------------
! SCRIPT: sprite_animation
! DESC: Displays two frames from a sprite sheet.
! AUTHOR: Mochi AI
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
! === Main Program =================
SPRITE K[1:face] SRC[0,0,64,64] D[2.0]
SPRITE K[1:face] SRC[64,0,64,64] D[0.2]
JMP LBL[9999:End]

LBL[9999:End]
! --- End of Program ---
[Main end]

[Keyframes start]
! === Keyframe Definitions ===========================
! This section is reserved for keyframe data.
[Keyframes end]

[Resources start]
! === Resource Definitions ===========================
K[1:face]: '../assets/sprites/face_sprite.png'
[Resources end]
