[Header start]
! ----------------------------------------------------
! SCRIPT: template
! DESC: A template showcasing all MochiScript features.
! AUTHOR: Mochi AI
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
! === Main Program ===================================
! The script starts executing from the first line.

LBL[1:Start]
    ! Show a static image for 2 seconds
    IMAGE K[1:logo] D[2.0]

    ! Play a GIF animation at 1.5x speed for 4 seconds
    GIF K[2:loading] SPD[1.5] D[4.0]

    ! Play a sequence from a sprite sheet
    SPRITE K[3:face] SRC[0,0,64,64] D[3.0] ! Eyes open
    SPRITE K[3:face] SRC[64,0,64,64] D[0.2] ! Blink
    SPRITE K[3:face] SRC[0,0,64,64] D[1.0] ! Eyes open

    JMP LBL[1] ! Loop back to the beginning

LBL[9999:End]
! --- End of Program ---
[Main end]

[Keyframes start]
! === Keyframe Definitions ===========================
! This section is reserved for keyframe data, which can be
! referenced by the main script.
! (Not yet implemented in the engine)
[Keyframes end]

[Resources start]
! === Resource Definitions ===========================
! All assets used in the script must be defined here.
K[1:logo]: 'assets/images/mochi_logo.png'
K[2:loading]: 'assets/gifs/loading_spinner.gif'
K[3:face]: 'assets/sprites/face_sprite.png'
[Resources end]
