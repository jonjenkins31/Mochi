[Header start]
! ----------------------------------------------------
! SCRIPT: random_emotes_config
! DESC: A self-contained script for displaying random emotes.
! AUTHOR: Conversion Tool
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
! This script defines and plays an emote animation.
LBL[1:Start]
    SPRITE K[1:emotes] SRC[0,0,32,32] D[0.5]
    SPRITE K[1:emotes] SRC[32,0,32,32] D[0.5]
    SPRITE K[1:emotes] SRC[64,0,32,32] D[0.5]
    SPRITE K[1:emotes] SRC[96,0,32,32] D[0.5]
    JMP LBL[1:Start]
LBL[9999:End]
[Main end]

[Keyframes start]
! === Keyframe Definitions ===========================
! In the future, the SRC coordinates above could be defined
! here as named keyframes.
[Keyframes end]

[Resources start]
K[1:emotes]: '../assets/bmps/random_emotes.bmp'
[Resources end]
