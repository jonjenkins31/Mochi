[Header start]
! ----------------------------------------------------
! SCRIPT: eyes_sequence
! DESC: A sequence of eye movements and expressions.
! AUTHOR: Conversion Tool
! VERSION: 2.0
! ----------------------------------------------------
[Header end]

[Main start]
LBL[1:Start]
    MATH NAME[eyes] FG[255,255,255] D[1.0]
    MATH NAME[wakeup] D[1.5]
    MATH NAME[blink] D[1.5]
    MATH NAME[look_left] D[1.5]
    MATH NAME[center] D[1.0]
    MATH NAME[look_right] D[1.5]
    MATH NAME[center] D[1.0]
    MATH NAME[blink] D[1.0]
    MATH NAME[sleep] D[1.0]
LBL[9999:End]
[Main end]

