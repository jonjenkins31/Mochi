{
  "name": "bitmap_secret",
  "description": "Telling a secret — the eyes check the room WHILE the line is spoken. A program counter cannot say this.",
  "loop": false,
  "schema_version": 1,
  "tracks": [
    {
      "kind": "animation", "target": "bitmap_man", "name": "eyes",
      "clips": [
        {"t_offset_ms": 0,    "label": "settle",       "payload": {"expression": "neutral"}},
        {"t_offset_ms": 900,  "label": "glance up",    "payload": {"expression": "look_up"}},
        {"t_offset_ms": 1700, "label": "glance down",  "payload": {"expression": "look_down"}},
        {"t_offset_ms": 2500, "label": "back to you",  "payload": {"expression": "neutral"}},
        {"t_offset_ms": 5200, "label": "confide",      "payload": {"expression": "closed"}},
        {"t_offset_ms": 5700, "label": "grin",         "payload": {"expression": "happy"}},
        {"t_offset_ms": 8200, "label": "settle",       "payload": {"expression": "neutral"}}
      ]
    },
    {
      "kind": "speech", "target": "bitmap_man", "name": "voice",
      "clips": [
        {"t_offset_ms": 600,  "label": "setup",
         "payload": {"text": "Can you keep a secret? Hold on."}},
        {"t_offset_ms": 3000, "label": "check",
         "payload": {"text": "Alright. Nobody is listening."}},
        {"t_offset_ms": 5400, "label": "the secret",
         "payload": {"text": "I am not really made of bitmaps. Do not tell anyone."}}
      ]
    },
    {
      "kind": "light", "target": "desk", "name": "mood",
      "clips": [
        {"t_offset_ms": 5200, "duration_ms": 3000, "label": "dim for the secret",
         "payload": {"rgb": [40, 30, 80]}}
      ]
    }
  ]
}
