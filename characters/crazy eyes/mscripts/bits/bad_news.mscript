[Main start]
MATH K[1] STATE[idle] D[0.8]
MOVE K[1] PATH[1,2] D[4.0] HOLD[0.5] EASE[out]
SAY TXT['So. I have something to tell you and I am going to do it slowly.']
MATH K[1] STATE[idle] SPIN[0.25] COLOR[#8A85A6] BLOOM[0.12] LOOK[downleft] D[1.8]
SAY TXT['It did not work.']
MATH K[1] STATE[idle] SPIN[0.25] COLOR[#8A85A6] BLOOM[0.12] GAZE[0,0] D[1.4]
SAY TXT['I ran it four times to be sure, because I did not want to come and tell you this after only one.']
MATH K[1] STATE[squint] SPIN[0.25] COLOR[#8A85A6] D[1.4]
SAY TXT['That is all. I am not going to dress it up. Take a minute.']
MATH K[1] STATE[idle] SPIN[0.5] COLOR[#51DAF8] BLOOM[0.30] D[2.0]
[Main end]
