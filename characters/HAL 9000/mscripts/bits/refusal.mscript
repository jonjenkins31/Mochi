[Header start]
! The refusal. HAL's signature move: deliver the unthinkable gently,
! and let the LENS do the threatening while the voice stays polite.
! Nothing raises. Everything tightens.
[Header end]

[Resources start]
K[1]: 'characters/HAL 9000/hal.py'
[Resources end]

[Keyframes start]
P[1]: STATE[idle] SIZE[1.00] GLOW[1.00] RATE[1.1] PULSE[0.16] COLOR[#FF1A08]
P[2]: STATE[idle] SIZE[1.35] GLOW[1.35] RATE[0.6] PULSE[0.08] COLOR[#FF1A08]
